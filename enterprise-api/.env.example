# Copy this file to .env and fill in your values
NODE_ENV=development
APP_NAME=EnterpriseAPI
APP_VERSION=1.0.0
PORT=3000
API_PREFIX=/api/v1

JWT_SECRET=change_me_to_a_random_32plus_char_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

LOG_LEVEL=debug
LOG_DIR=logs

CORS_ORIGIN=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=enterprise_db
DB_USER=postgres
DB_PASSWORD=
