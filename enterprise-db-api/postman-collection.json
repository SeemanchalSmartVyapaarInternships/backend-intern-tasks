{
  "info": {
    "name": "Enterprise DB API",
    "description": "Production-ready REST API — Node.js + Express + MySQL + Sequelize",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:3000/api", "type": "string" }
  ],
  "item": [

    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": "http://localhost:3000/health" }
        }
      ]
    },

    {
      "name": "Roles",
      "item": [
        {
          "name": "Get All Roles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/roles?page=1&limit=10&search=admin&sort=name&order=ASC",
              "host": ["{{BASE_URL}}"],
              "path": ["roles"],
              "query": [
                { "key": "page",  "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search","value": "admin" },
                { "key": "sort",  "value": "name" },
                { "key": "order", "value": "ASC" }
              ]
            }
          }
        },
        {
          "name": "Get Role By ID",
          "request": { "method": "GET", "url": "{{BASE_URL}}/roles/1" }
        },
        {
          "name": "Create Role",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/roles",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"DevOps Engineer\",\n  \"description\": \"Infrastructure and CI/CD management\",\n  \"permissions\": [\"read:projects\", \"write:deployments\"],\n  \"isActive\": true\n}"
            }
          }
        },
        {
          "name": "Update Role",
          "request": {
            "method": "PUT",
            "url": "{{BASE_URL}}/roles/1",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated description\",\n  \"isActive\": true\n}"
            }
          }
        },
        {
          "name": "Delete Role",
          "request": { "method": "DELETE", "url": "{{BASE_URL}}/roles/6" }
        }
      ]
    },

