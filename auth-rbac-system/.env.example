# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
MONGO_URI=mongodb://127.0.0.1:27017/enterprise_rbac_db

# ===========================================
# JWT CONFIGURATION
# ===========================================
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# COOKIE CONFIGURATION
# ===========================================
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# ===========================================
# PASSWORD RESET CONFIGURATION
# ===========================================
RESET_PASSWORD_TOKEN_EXPIRES_MIN=15
CLIENT_RESET_PASSWORD_URL=http://localhost:3000/reset-password

# ===========================================
# BCRYPT CONFIGURATION
# ===========================================
BCRYPT_SALT_ROUNDS=12

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ===========================================
# CORS CONFIGURATION
# ===========================================
CORS_ORIGIN=http://localhost:3000

# ===========================================
# EMAIL (NODEMAILER) CONFIGURATION
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
EMAIL_FROM="Enterprise RBAC System <no-reply@example.com>"

# ===========================================
# SUPER ADMIN SEED (used by seed script)
# ===========================================
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe@123
